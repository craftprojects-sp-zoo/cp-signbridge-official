<?xml version="1.0" encoding="utf-8"?>
<!-- SignBridge — pakiet MSI (per-machine, bez interfejsu) — instaluje OBIE części: dostawcę podpisu (serwer)
     i wtyczkę pulpitu zdalnego (komputer z kartą); ten sam pakiet wszędzie.
     Instalacja:    msiexec /i "SignBridge.msi" /qn
     Odinstalowanie: msiexec /x "SignBridge.msi" /qn
     Pakiet kopiuje program do Program Files\cp-signbridge i uruchamia go z "- -install-all - -msi",
     co rejestruje dostawcę podpisu i wtyczkę (DLL wbudowane w program) oraz autostart panelu dla każdego użytkownika. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SignBridge" Manufacturer="Craftprojects Sp. z o.o."
           Version="$(var.Version)" UpgradeCode="0a0bc45a-2dcf-4bdd-8b2b-c202f724bc39"
           Scope="perMachine" Language="1045" Codepage="65001" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="Nowsza wersja programu jest już zainstalowana." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="$(var.Root)\src\panel\res\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://craftprojects.pl" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="cp-signbridge" />
    </StandardDirectory>

    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="0b8032f7-9542-4754-a0a9-a766e0a93744" Bitness="always64">
        <File Id="AppExe" Source="$(var.Root)\dist\SignBridge Installer.exe" Name="SignBridge.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Feature Id="Main" Title="SignBridge" Level="1">
      <ComponentGroupRef Id="Files" />
    </Feature>

    <CustomAction Id="Configure" FileRef="AppExe" ExeCommand="--install-all --msi --quiet" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Unconfigure" FileRef="AppExe" ExeCommand="--uninstall-all --msi --quiet" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="Configure" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="Unconfigure" After="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
